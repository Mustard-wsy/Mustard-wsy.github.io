---
import Base from '../../layouts/Base.astro';
import ToyGrid from '../../components/ToyGrid.astro';
import { library } from '../../lib/content';
const { toys } = await library();
---

<Base title="玩具架" section="toys">
  <header class="page-heading">
    <div>
      <p class="eyebrow">TOYS</p>
      <h1>玩具架</h1>
      <p>做过的小玩具和实验。</p>
    </div>
  </header>
  {toys.length ? (
    <ToyGrid entries={toys} heading="h2" />
  ) : (
    <div class="empty-state">
      <span>暂无玩具</span>
      <p>玩具发布后会显示在这里。</p>
    </div>
  )}
</Base>
