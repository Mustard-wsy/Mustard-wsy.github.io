---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { library } from '../../lib/content';
import { url, displayDate, statusLabels } from '../../lib/site';
export async function getStaticPaths() {
  const { toys } = await library();
  return toys.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const labels = { source: '查看源码', demo: '打开演示', download: '下载' };
---

<Base title={data.title} description={data.description} section="toys">
  <header class="article-heading">
    <a class="back-link" href={url('/toys/')}>
      ← 返回玩具架
    </a>
    <div class="entry-meta">{data.tags.join(' / ')}</div>
    <h1>{data.title}</h1>
    <p class="article-deck">{data.description}</p>
    <div class="article-meta">
      <time datetime={data.publishedAt}>{displayDate(data.publishedAt)}</time>
      {data.status && <span>{statusLabels[data.status]}</span>}
    </div>
  </header>
  <div class="toy-detail">
    {data.video ? (
      <figure>
        <video
          controls
          preload="metadata"
          poster={data.video.poster && url(data.video.poster)}
          aria-label={data.video.description}
        >
          <source src={url(data.video.src)} />
        </video>
        <figcaption>{data.video.description}</figcaption>
      </figure>
    ) : (
      data.cover && (
        <img
          class="detail-image"
          src={url(data.cover.src)}
          alt={data.cover.alt}
          width="960"
          height="600"
        />
      )
    )}
    {data.links && (
      <div class="project-links">
        {Object.entries(data.links).map(
          ([key, href]) =>
            href && (
              <a class="text-link" href={href}>
                {labels[key as keyof typeof labels]} ↗
              </a>
            ),
        )}
      </div>
    )}
    <div class="prose">
      <Content />
    </div>
  </div>
</Base>
