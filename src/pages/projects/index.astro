---
import Base from '../../layouts/Base.astro';
import ToyGrid from '../../components/ToyGrid.astro';
import { library } from '../../lib/content';
const { projects } = await library();
---

<Base title="项目目录" section="projects">
  <header class="page-heading">
    <div>
      <p class="eyebrow">PROJECTS</p>
      <h1>项目目录</h1>
      <p>持续维护的工具、应用和其他项目。</p>
    </div>
  </header>
  {projects.length ? (
    <ToyGrid entries={projects} catalog="projects" heading="h2" />
  ) : (
    <div class="empty-state">
      <span>暂无项目</span>
      <p>项目发布后会显示在这里。</p>
    </div>
  )}
</Base>
