---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { library } from '../../lib/content';
import { url, displayDate } from '../../lib/site';
import 'katex/dist/katex.min.css';
export async function getStaticPaths() {
  const { writing } = await library();
  return writing.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;
const { topics, writing } = await library();
const topic = topics.find((t) => t.data.slug === data.topic);
const siblings = topic
  ? writing
      .filter((e) => e.data.topic === data.topic)
      .sort((a, b) => a.data.topicOrder! - b.data.topicOrder!)
  : [];
const current = siblings.findIndex((e) => e.id === entry.id);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={data.title} description={data.description} section="writing">
  <article>
    <header class="article-heading">
      <a
        class="back-link"
        href={topic ? url(`/topics/${topic.data.slug}/`) : url('/writing/')}
      >
        ← {topic ? topic.data.title : '全部文章'}
      </a>
      <div class="entry-meta">{data.tags.join(' / ')}</div>
      <h1>{data.title}</h1>
      <p class="article-deck">{data.description}</p>
      <div class="article-meta">
        <time datetime={data.publishedAt}>{displayDate(data.publishedAt)}</time>
        {data.updatedAt && <span>更新于 {displayDate(data.updatedAt)}</span>}
      </div>
    </header>
    <div class="reading-layout">
      {toc.length >= 3 && (
        <aside class="toc">
          <details open>
            <summary>这篇手记的线索</summary>
            <ol>
              {toc.map((h, index) => (
                <li class:list={{ nested: h.depth === 3 }}>
                  <a href={`#${h.slug}`}>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        </aside>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>
    <footer class="article-end">
      <div>
        {siblings[current - 1] && (
          <a href={url(`/writing/${siblings[current - 1].data.slug}/`)}>
            ← {siblings[current - 1].data.title}
          </a>
        )}
        {siblings[current + 1] && (
          <a href={url(`/writing/${siblings[current + 1].data.slug}/`)}>
            {siblings[current + 1].data.title} →
          </a>
        )}
      </div>
      <a class="text-link" href={url('/writing/')}>
        返回文章列表 ↗
      </a>
    </footer>
  </article>
</Base>
