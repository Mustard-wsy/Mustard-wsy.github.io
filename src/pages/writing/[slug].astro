---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import { library } from '../../lib/content';
import { folderPath, folderLink } from '../../lib/writing-folders.mjs';
import { resolve } from 'node:path';
import { url } from '../../lib/site';
import PublicationDate from '../../components/PublicationDate.astro';
import 'katex/dist/katex.min.css';
export async function getStaticPaths() {
  const { writing } = await library();
  return writing.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;
const { topics, writing, folders } = await library();
const directory = folderPath(
  entry,
  resolve(
    process.env.DEMO_MODE === 'true' ? 'fixtures/writing' : 'content/writing',
  ),
);
const folder = folders.find((f) => f.path === directory)!;
const topic = topics.find((t) => t.data.slug === data.topic);
const siblings = topic
  ? writing
      .filter((e) => e.data.topic === data.topic)
      .sort((a, b) => a.data.topicOrder! - b.data.topicOrder!)
  : [];
const current = siblings.findIndex((e) => e.id === entry.id);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={data.title} description={data.description} section="writing">
  <article>
    <header class="article-heading">
      <a class="back-link" href={url(folderLink(directory))}>
        ← {folder.title}
      </a>
      <div class="entry-meta">{data.tags.join(' / ')}</div>
      <h1>{data.title}</h1>
      <p class="article-deck">{data.description}</p>
      <div class="article-meta">
        <PublicationDate data={data} />
      </div>
    </header>
    <div class="reading-layout">
      {toc.length >= 3 && <ArticleToc headings={toc} />}
      <div class="prose">
        <Content />
      </div>
    </div>
    <footer class="article-end">
      {topic && (
        <a class="text-link" href={url(`/topics/${topic.data.slug}/`)}>
          阅读专题:{topic.data.title} ↗
        </a>
      )}
      <div>
        {siblings[current - 1] && (
          <a href={url(`/writing/${siblings[current - 1].data.slug}/`)}>
            ← {siblings[current - 1].data.title}
          </a>
        )}
        {siblings[current + 1] && (
          <a href={url(`/writing/${siblings[current + 1].data.slug}/`)}>
            {siblings[current + 1].data.title} →
          </a>
        )}
      </div>
      <a class="text-link" href={url(folderLink(directory))}>
        返回{folder.title} ↗
      </a>
    </footer>
  </article>
</Base>
