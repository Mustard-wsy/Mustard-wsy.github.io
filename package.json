{
  "name": "mustard-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:demo": "cross-env DEMO_MODE=true astro dev --host 127.0.0.1",
    "build": "node scripts/astro-isolated.mjs build",
    "build:demo": "cross-env DEMO_MODE=true node scripts/astro-isolated.mjs build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node scripts/astro-isolated.mjs check",
    "test": "node --test tests/*.test.mjs",
    "preview:demo": "cross-env DEMO_MODE=true astro preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean:punctuation": "node scripts/clean-punctuation.mjs --write",
    "clean:punctuation:check": "node scripts/clean-punctuation.mjs --check",
    "publish:notes": "node scripts/publish.mjs",
    "publish:watch": "node scripts/publish.mjs --watch",
    "publish:site": "node --use-env-proxy scripts/publish-site.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "dev:local": "cross-env DEMO_MODE=false LOCAL_PREVIEW=true astro dev --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "astro": "^7.3.8",
    "katex": "^0.19.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "parse5": "^7.3.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
